    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Inter:wght@400;500;600&family=Lora:wght@400;500&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      @font-face {
        font-family: "Suisse Intl";
        src: url("assets/fonts/SuisseIntlTrial-Light.otf") format("opentype");
        font-weight: 300;
        font-style: normal;
      }
      @font-face {
        font-family: "Suisse Intl";
        src: url("assets/fonts/SuisseIntlTrial-Regular.otf") format("opentype");
        font-weight: 400;
        font-style: normal;
      }
      @font-face {
        font-family: "Suisse Intl";
        src: url("assets/fonts/SuisseIntlTrial-Medium.otf") format("opentype");
        font-weight: 500;
        font-style: normal;
      }
      @font-face {
        font-family: "Suisse Intl";
        src: url("assets/fonts/SuisseIntlTrial-Semibold.otf") format("opentype");
        font-weight: 600;
        font-style: normal;
      }

      :root {
        --page-cream: #faf0d8;
        --ink: #3d2e1f;
        --ink-soft: rgba(61, 46, 31, 0.88);
        --on-dark: #f5e6d0;
        --console-text: #f2e8da;
        --gold-text: linear-gradient(180deg, #e8c08e 0%, #d4a574 52%, rgba(212, 165, 116, 0.72) 100%);
        --dusk-back: #1a1208;
        --dusk-horizon: #e8a060;
        --dusk-clay: #c45c42;
        --dusk-sand: #f2d8a8;
        --pi-reading: #f4f1ea;
        --pi-ink: #1e1612;
        --pi-ink-soft: #3a322c;
        --pi-muted: rgba(38, 32, 28, 0.58);
        --pi-line: rgba(38, 32, 28, 0.09);
        --pi-bar: linear-gradient(180deg, #d4a574 0%, rgba(212, 165, 116, 0.38) 100%);
        --card-from: #2a2118;
        --card-to: #171008;
        --card-border: rgba(212, 165, 116, 0.14);
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      html, body {
        width: 1920px;
        height: 1080px;
        overflow: hidden;
        background: #000;
      }

      #root {
        position: relative;
        width: 1920px;
        height: 1080px;
        overflow: hidden;
        font-family: Inter, system-ui, sans-serif;
        color: var(--ink);
      }

      .font-lora { font-family: Lora, Georgia, serif; }
      .font-suisse { font-family: "Suisse Intl", Inter, system-ui, sans-serif; }
      .font-dm { font-family: "DM Sans", Inter, system-ui, sans-serif; }
      .font-inter { font-family: Inter, system-ui, sans-serif; }

      .gold-text {
        background: var(--gold-text);
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
      }

      .clip-layer {
        position: absolute;
        inset: 0;
        overflow: hidden;
        will-change: transform, opacity;
      }

      .scene-shell {
        position: absolute;
        inset: 0;
        will-change: transform, opacity;
      }

      .bg-hero {
        background:
          radial-gradient(ellipse 130% 95% at 50% 115%, rgba(232, 160, 96, 0.28), transparent 58%),
          radial-gradient(ellipse 55% 45% at 18% 8%, rgba(196, 92, 66, 0.18), transparent 62%),
          radial-gradient(ellipse 40% 35% at 82% 22%, rgba(242, 216, 168, 0.14), transparent 68%),
          var(--dusk-back);
      }

      .bg-hero::after {
        content: "";
        position: absolute;
        inset: 0;
        opacity: 0.055;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        pointer-events: none;
        mix-blend-mode: soft-light;
      }

      .bg-cream { background: var(--page-cream); }

      .bg-console {
        background:
          radial-gradient(ellipse 72% 58% at 50% 0%, rgba(245, 230, 208, 0.1), transparent 68%),
          radial-gradient(ellipse 42% 42% at 88% 82%, rgba(168, 118, 84, 0.12), transparent 62%),
          linear-gradient(168deg, #241c14 0%, #151008 100%);
      }

      .grain {
        display: none;
      }

      .bg-doe-brown {
        background:
          radial-gradient(ellipse 72% 58% at 50% 0%, rgba(245, 230, 208, 0.08), transparent 68%),
          linear-gradient(168deg, #241c14 0%, #1a1208 55%, #151008 100%);
      }

      .logo-sting {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .logo-sting__mark {
        font-size: 320px;
        font-weight: 400;
        letter-spacing: -0.04em;
        line-height: 1;
        transform-origin: center center;
      }

      /* ── Shared band layout ── */
      .band {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 56px 88px 40px;
        gap: 22px;
      }

      .console-card {
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        border: 1px solid var(--card-border);
        border-radius: 16px;
        background: linear-gradient(168deg, var(--card-from), var(--card-to));
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035), 0 20px 48px rgba(26, 18, 8, 0.32);
        overflow: hidden;
      }

      .section-title {
        max-width: 1240px;
        margin: 0 auto;
        font-size: 78px;
        font-weight: 400;
        letter-spacing: -0.035em;
        line-height: 1.02;
      }

      .section-title span { display: block; }

      .eyebrow {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(61, 46, 31, 0.52);
        margin-bottom: 8px;
      }

      /* ── Day summary ── */
      .day-summary {
        padding: 30px 34px 34px;
        background: var(--pi-reading);
        color: var(--pi-ink);
      }

      .day-summary__greeting-line {
        color: var(--pi-ink-soft);
        font-size: 30px;
        letter-spacing: -0.02em;
        line-height: 1.05;
      }

      .day-summary__greeting-name {
        color: var(--pi-ink);
        font-size: 48px;
        letter-spacing: -0.035em;
        line-height: 0.95;
        margin-top: 4px;
      }

      .day-summary__label {
        margin-top: 20px;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(38, 32, 28, 0.48);
      }

      .day-summary__row {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 22px;
        margin-top: 16px;
        align-items: end;
        min-height: 168px;
      }

      .day-summary__total-value {
        font-size: 72px;
        line-height: 1;
        letter-spacing: -0.03em;
      }

      .day-summary__total-label {
        margin-top: 6px;
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(38, 32, 28, 0.48);
      }

      .volume-bars {
        display: flex;
        align-items: flex-end;
        gap: 4px;
        height: 132px;
      }

      .volume-bar {
        flex: 1;
        min-width: 4px;
        border-radius: 999px;
        background: var(--pi-bar);
      }

      .volume-bar--night {
        background: linear-gradient(180deg, #c4c0b7 0%, rgba(196, 192, 183, 0.55) 100%);
        opacity: 0.78;
      }

      .volume-labels {
        display: flex;
        justify-content: space-between;
        margin-top: 8px;
        font-size: 9px;
        color: rgba(38, 32, 28, 0.58);
      }

      .day-summary__stats {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 22px;
        margin-top: 20px;
        align-items: center;
      }

      .ring {
        position: relative;
        width: 96px;
        height: 96px;
        flex-shrink: 0;
      }

      .ring svg { width: 100%; height: 100%; display: block; }

      .ring__track, .ring__prog { fill: none; }

      .ring__track { stroke: #d0ccc3; }

      .ring__prog {
        stroke: #6e6258;
        stroke-width: 7;
        stroke-linecap: round;
      }

      .ring__inner {
        position: absolute;
        inset: 5px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background: var(--pi-reading);
      }

      .ring__val { font-size: 16px; letter-spacing: -0.02em; }

      .ring__cap {
        font-size: 8px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: rgba(38, 32, 28, 0.48);
      }

      .stat-strip {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
      }

      .stat-strip__item {
        padding: 6px 14px;
        border-left: 1px solid var(--pi-line);
      }

      .stat-strip__item:first-child { border-left: 0; padding-left: 0; }

      .stat-strip__val {
        font-size: 36px;
        line-height: 1;
        letter-spacing: -0.02em;
      }

      .stat-strip__label {
        margin-top: 4px;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(38, 32, 28, 0.48);
      }

      .stat-strip__detail {
        margin-top: 2px;
        font-size: 12px;
        color: var(--pi-muted);
      }

      /* ── Live call ── */
      .live { padding: 26px 30px 30px; color: var(--console-text); }

      .live__crumbs {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-bottom: 14px;
        margin-bottom: 16px;
        border-bottom: 1px solid rgba(242, 232, 218, 0.1);
        font-size: 12px;
      }

      .live__crumb { color: rgba(242, 232, 218, 0.72); }

      .live__crumb--on { color: var(--console-text); }

      .live__sep { color: rgba(242, 232, 218, 0.28); }

      .live-turn { margin-bottom: 18px; }

      .live-turn__meta {
        display: flex;
        gap: 10px;
        margin-bottom: 6px;
        font-size: 10px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .live-turn__who { color: #d4a574; font-weight: 600; }

      .live-turn__who--agent { color: #b8845c; }

      .live-turn__time { color: rgba(242, 232, 218, 0.62); }

      .live-turn__text {
        font-size: 24px;
        line-height: 1.38;
        color: rgba(242, 232, 218, 0.94);
        max-width: 980px;
      }

      .live-turn__tag { color: #e8c08e; font-weight: 500; }

      .live-turn__steps {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 8px 0 10px;
      }

      .live-turn__step {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 999px;
        background: rgba(212, 165, 116, 0.12);
        border: 1px solid rgba(212, 165, 116, 0.22);
        font-size: 10px;
        color: rgba(242, 232, 218, 0.82);
      }

      /* ── Sarah + A1C ── */
      .sarah-panel {
        position: relative;
        min-height: 500px;
        padding: 26px 30px;
      }

      .sarah-chart {
        position: absolute;
        left: 50%;
        top: 46%;
        transform: translate(-50%, -50%);
        width: 700px;
        padding: 22px 24px;
        border-radius: 14px;
        background: rgba(244, 241, 234, 0.98);
        border: 1px solid rgba(38, 32, 28, 0.08);
      }

      .sarah-chart__label {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(38, 32, 28, 0.62);
        margin-bottom: 10px;
      }

      .sarah-chart svg { width: 100%; height: 130px; display: block; }

      .sarah-name {
        position: absolute;
        right: 42px;
        bottom: 32px;
        text-align: right;
        color: var(--console-text);
      }

      .sarah-name__lines {
        font-size: 56px;
        line-height: 0.94;
        letter-spacing: -0.035em;
        font-weight: 500;
      }

      .sarah-name__meta {
        display: flex;
        justify-content: flex-end;
        gap: 16px;
        margin-top: 12px;
        font-size: 12px;
        color: rgba(242, 232, 218, 0.58);
      }

      .sarah-name__val {
        color: rgba(242, 232, 218, 0.9);
        font-size: 14px;
        margin-bottom: 2px;
      }

      /* ── Agents orbit ── */
      .orbit-wrap {
        padding: 32px;
        min-height: 440px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .orbit {
        position: relative;
        width: 500px;
        height: 500px;
      }

      .orbit__hub {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        color: var(--console-text);
      }

      .orbit__hub-label {
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(242, 232, 218, 0.52);
      }

      .orbit__hub-num {
        font-size: 44px;
        line-height: 1;
        margin-top: 2px;
        color: #e8c08e;
      }

      .orbit-node {
        position: absolute;
        width: 102px;
        height: 102px;
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        border: 1px solid rgba(212, 165, 116, 0.22);
        background: linear-gradient(168deg, rgb(42, 33, 24), rgb(23, 16, 8));
        color: rgba(242, 232, 218, 0.9);
        font-size: 10px;
        line-height: 1.12;
        text-align: center;
      }

      .orbit-node svg { width: 20px; height: 20px; color: #d4a574; }

      /* ── Outro ── */
      .outro {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
      }

      .outro__wordmark {
        font-size: 168px;
        font-weight: 400;
        letter-spacing: -0.04em;
        line-height: 1;
        color: #1a1208;
      }

      .outro__url {
        margin-top: 6px;
        font-size: 34px;
        letter-spacing: 0.08em;
        color: #856849;
      }

      .outro__line {
        margin-top: 18px;
        font-size: 28px;
        letter-spacing: -0.018em;
        color: rgba(61, 46, 31, 0.72);
        max-width: 720px;
      }

      .flash {
        position: absolute;
        inset: 0;
        background: var(--page-cream);
        opacity: 0;
        pointer-events: none;
        z-index: 50;
      }
    </style>
  </head>
