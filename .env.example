# Supabase — Doe project (https://supabase.com/dashboard/project/tnferryxxngdoprlustj)
NEXT_PUBLIC_SUPABASE_URL=https://tnferryxxngdoprlustj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional server-only alias (same value as NEXT_PUBLIC_SUPABASE_ANON_KEY)
# SUPABASE_ANON_KEY=your-anon-key
# Required for /join and /admin server routes — never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# /admin sign-in uses email/password. Allowlist is enforced server-side.
# One-time setup: ADMIN_INITIAL_PASSWORD=... node scripts/ensure-admin-auth-user.mjs

# Resend — sends applicant card copy on /join submit (https://resend.com)
# Vercel (recommended): Project → Settings → Environment Variables
#   RESEND_API_KEY=re_xxxxxxxxx   ← replace with your real key from Resend dashboard
#   RESEND_FROM_EMAIL=James <james@doe.care>   ← default if unset; any verified @doe.care address works
# Supabase Edge Functions only: add RESEND_API_KEY as a Supabase secret instead (not needed for current Next.js flow).
# Submissions still save when RESEND_API_KEY is missing; confirmation email is skipped.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=James <james@doe.care>

# Primary marketing domain (default: doe.care)
PRIMARY_SITE_HOST=doe.care

# Designers landing domain — rewrites site root to /doehealth (default: doehealth.care)
DESIGNERS_SITE_HOST=doehealth.care

# Legacy alias for DESIGNERS_SITE_HOST
JOIN_SITE_HOST=doehealth.care

# Absolute URL for "Join Waitlist" links (default: https://doe.care/join)
NEXT_PUBLIC_JOIN_URL=https://doe.care/join

# Doe DTC — consumer iMessage companion
# LINQ_API_KEY=linq_...
# LINQ_WEBHOOK_SECRET=whsec_...
# DOEDTC_PUBLIC_ORIGIN=https://doe.care
# DOEDTC_LINQ_PHONE_NUMBER=+19492830865
# DOEDTC_CONTACT_CARD_IMAGE_URL=https://doe.care/images/doe-contact-card.png
# OPENAI_API_KEY=...  (required for symptom assessments)
# DOEDTC_AGENT_RUNTIME=legacy|sdk  (default: sdk)
# DOEDTC_AGENT_MODEL=gpt-4o

# --- Production Doe agent (Vercel) — required for browse + memory + vault ---
# Cursor MCP (.cursor/mcp.json: supabase, mem0, kernel) uses OAuth for IDE/dev agents only.
# MCP does NOT replace SUPABASE_SERVICE_ROLE_KEY, MEM0_API_KEY, or KERNEL_API_KEY on Vercel.

# Mem0 — semantic memory (lib/doedtc/doedtc-memory.ts)
# Get a key at https://app.mem0.ai (starts with m0-).
# MEM0_API_KEY=m0-...

# Kernel — cloud browsers (lib/doedtc/doedtc-browser.ts)
# Get a key at https://onkernel.com
# KERNEL_API_KEY=...

# Vercel Blob — browser screenshot storage (lib/doedtc/doedtc-shots.ts)
# BLOB_READ_WRITE_TOKEN=...

# AES-256-GCM for vault passwords + browser credential locker (lib/doedtc/doedtc-crypto.ts)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DOEDTC_BROWSER_ENCRYPTION_KEY=...
# Optional alias (same value):
# DOEDTC_LOCKER_KEY=...
